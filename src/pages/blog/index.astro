---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' });
---

<Base title="บล็อก" description="บทความและบันทึกการทำงาน">
  <h1>บล็อก</h1>
  <p class="muted">บันทึกสิ่งที่เรียนรู้และวิธีทำงาน</p>
  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
          <span class="muted">{post.data.description}</span>
        </li>
      ))
    }
  </ul>
</Base>
