---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.summary}>
  <article class="prose">
    <p><a href={`${import.meta.env.BASE_URL}projects/`}>← ผลงานทั้งหมด</a></p>
    <h1>{project.data.title}</h1>
    <p class="muted">{project.data.year} · {project.data.role}</p>
    <p>{project.data.tags.map((t) => <span class="tag">{t}</span>)}</p>
    {
      project.data.link && (
        <p>
          <a class="btn ghost" href={project.data.link} target="_blank" rel="noopener">
            ดูตัวงานจริง ↗
          </a>
        </p>
      )
    }
    <Content />
  </article>
</Base>
